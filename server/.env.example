PORT=4000
# Leave empty to use an embedded local MongoDB (dev only). For real use, a free MongoDB Atlas URI:
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Allow monitoring localhost / private network IPs (keep false in production - SSRF protection)
ALLOW_PRIVATE_TARGETS=false
# Optional: SMTP for email alerts. If empty, alerts are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=DevPulse <alerts@devpulse.local>
